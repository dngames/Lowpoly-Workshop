include README.md LICENSE CHANGELOG.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md PROVENANCE.json VALIDATION.md
recursive-include docs *.md *.png *.json
recursive-include benchmarks *.md *.csv
recursive-include tests *.py
recursive-include scripts *.py *.mjs
