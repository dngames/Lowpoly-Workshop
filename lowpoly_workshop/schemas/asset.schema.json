{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lowpoly Workshop asset v2",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "kind",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "static-prop",
        "hollow-prop",
        "wearable",
        "articulated",
        "character"
      ]
    },
    "profile": {
      "enum": [
        "portable",
        "mobile"
      ]
    },
    "generator": {
      "type": "string"
    },
    "out_dir": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "\\.glb$"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contract": {
            "type": "object"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "source"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "source": {
            "enum": [
              "original",
              "generated",
              "rendered"
            ]
          }
        }
      }
    },
    "poses": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "type"
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "type": {
            "enum": [
              "connected",
              "clear",
              "fit",
              "support"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object"
    },
    "sets": {
      "type": "object"
    },
    "workflow": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "stage",
          "output",
          "nodes",
          "basis",
          "views",
          "modes",
          "poses"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "proportions",
              "construction",
              "appearance",
              "motion-export"
            ]
          },
          "output": {
            "type": "string",
            "pattern": "\\.glb$"
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "basis": {
            "enum": [
              "observed",
              "inferred"
            ]
          },
          "notes": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "views": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "front",
                "back",
                "side",
                "quarter",
                "top",
                "below"
              ]
            }
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "textured",
                "plain",
                "checker",
                "wireframe"
              ]
            }
          },
          "poses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "view": {
                  "type": "string"
                },
                "box": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "inferred"
                }
              }
            },
            "then": {
              "required": [
                "notes"
              ],
              "properties": {
                "notes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "observed"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
